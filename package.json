{
  "name": "storygen",
  "version": "1.0.0",
  "private": true,
  "description": "A parent-supervised illustrated bedtime-story generator starring your child, built with OpenAI and Cloudflare.",
  "author": "David Liang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DLiang-pub/storygen.git"
  },
  "bugs": {
    "url": "https://github.com/DLiang-pub/storygen/issues"
  },
  "keywords": [
    "bedtime-stories",
    "openai",
    "image-generation",
    "nextjs",
    "cloudflare"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "postcss": "8.5.14",
    "sharp": "0.35.0"
  },
  "type": "module"
}
